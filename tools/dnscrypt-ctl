#!/system/bin/sh
# Управление модулем с телефона: dnscrypt-ctl <команда>
# Команды json/set рассчитаны на вызов из внешнего приложения через su.
MODDIR=/data/adb/modules/dnscrypt-proxy-android
export MODDIR
. "$MODDIR/scripts/common.sh"
. "$MODDIR/scripts/netfilter.sh"
load_settings

usage() {
  cat <<USAGE
dnscrypt-ctl <команда>

  status    состояние прокси, порт, правила перехвата
  json      то же одной строкой JSON (для внешних приложений)
  set K V   изменить настройку в module.conf
  reset     вернуть все настройки модуля к значениям по умолчанию
  servers <подкоманда>  список резолверов и выбор серверов (см. ниже)
  start     запустить присмотр (supervisor)
  stop      остановить прокси и снять правила (сохраняется после перезагрузки)
  restart   перезапустить с перечитыванием конфига
  rules     показать цепочку $NAT_CHAIN
  conflicts кто ещё перехватывает DNS: box_for_magisk, zapret2 и прочие
  log       последние строки журнала модуля
  proxylog  последние строки журнала dnscrypt-proxy
  test      проверить резолвинг через локальный порт

Коды возврата: 0 - успех, 1 - ошибка аргументов или состояния.
USAGE
}

stop_all() {
  for f in "$LOCKFILE" "$PIDFILE"; do
    pid=$(cat "$f" 2>/dev/null)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    rm -f "$f"
  done
  pkill -f "$MODDIR/system/bin/dnscrypt-proxy" 2>/dev/null
}

start_supervisor() { ( "$MODDIR/scripts/supervisor.sh" >/dev/null 2>&1 & ) ; }

# Забирает ли box_for_magisk порт 53 прямо сейчас: REDIRECT в CLASH_DNS_*
# (ядро clash) или TPROXY/MARK по порту 53 в mangle-цепочках BOX_*.
box_takes_dns() {
  $IPT -t nat -S 2>/dev/null | grep -qE '^-A CLASH_DNS[A-Z_]* .*dport 53 .*-j (REDIRECT|DNAT)' && return 0
  $IPT -t mangle -S 2>/dev/null | grep -qE '^-A BOX_[A-Z_]* .*dport 53 .*-j (TPROXY|MARK)'
}

supervisor_running() {
  sup=$(cat "$LOCKFILE" 2>/dev/null)
  [ -n "$sup" ] && kill -0 "$sup" 2>/dev/null
}

# Сумма пакетов, прошедших через DNAT нашей цепочки (IPv4 и IPv6).
dnat_packets() {
  { $IPT -t nat -L $NAT_CHAIN -v -n -x 2>/dev/null; $IPT6 -t nat -L $NAT_CHAIN -v -n -x 2>/dev/null; } \
    | awk '/DNAT/ { s += $1 } END { print s + 0 }'
}

# Проверка значения перед записью: иначе «применится после restart»
# обещало то, что load_settings потом молча отбросит.
valid_value() {
  case "$1" in
    autostart|redirect_ipv4|tether_redirect|disable_private_dns)
      case "$2" in true|false) return 0 ;; esac
      echo "$1: допустимо true или false" ;;
    redirect_ipv6)
      case "$2" in auto|redirect|off) return 0 ;; esac
      echo "redirect_ipv6: допустимо auto, redirect или off" ;;
    restart_delay_max)
      case "$2" in ""|*[!0-9]*) ;; *) [ "$2" -ge 5 ] && [ "$2" -le 600 ] && return 0 ;; esac
      echo "restart_delay_max: целое число от 5 до 600" ;;
    run_gid)
      case "$2" in ""|net_admin|inet|net_raw) return 0 ;; *[!0-9]*) ;; *) return 0 ;; esac
      echo "run_gid: net_admin, inet, net_raw, числовой GID или default" ;;
  esac
  return 1
}


case "$1" in
  status)
    pid=$(dnscrypt_pid) && echo "dnscrypt-proxy: работает, pid $pid" || echo "dnscrypt-proxy: остановлен"
    sup=$(cat "$LOCKFILE" 2>/dev/null)
    if [ -n "$sup" ] && kill -0 "$sup" 2>/dev/null; then echo "supervisor: работает, pid $sup"; else echo "supervisor: остановлен"; fi
    p6=$(listen_port6)
    echo "порт: $(listen_port)${p6:+, IPv6 $p6}"
    echo "конфиг: $CONFIG"
    nf_init_cmd
    if nf_check; then echo "перехват IPv4: активен"; else echo "перехват IPv4: правил нет"; fi
    if ! dnscrypt_pid >/dev/null && ! nf_check; then
      echo "DNS: прокси остановлен, система резолвит сама"
    else
      case "$(nf_ipv6_state)" in
        redirected) echo "IPv6 DNS: перехвачен" ;;
        blocked)    echo "IPv6 DNS: заблокирован, система ходит по IPv4 (нет ip6tables nat)" ;;
        *)          echo "IPv6 DNS: идёт мимо прокси" ;;
      esac
    fi
    echo "Private DNS: $(settings get global private_dns_mode 2>/dev/null)"
    ;;
  json)
    pid=$(dnscrypt_pid) || pid=""
    sup=$(cat "$LOCKFILE" 2>/dev/null)
    kill -0 "$sup" 2>/dev/null || sup=""
    nf_init_cmd
    if nf_check; then rules=true; else rules=false; fi
    if [ -n "$pid" ]; then running=true; else running=false; fi
    p6=$(listen_port6)
    # port6 - число или null, как port; раньше он отдавался строкой.
    printf '{"running":%s,"pid":%s,"supervisor_pid":%s,"port":%s,"port6":%s,"rules_v4":%s,"redirect_ipv6":"%s","ipv6_dns":"%s","box_dns":%s,"tether_redirect":%s,"private_dns":"%s","config":"%s","version":"%s","servers":"%s","resolvers_cached":%s,"manual_stop":%s}\n' \
      "$running" "${pid:-null}" "${sup:-null}" "$(listen_port)" "${p6:-null}" \
      "$rules" "$redirect_ipv6" "$(nf_ipv6_state)" "$(box_takes_dns && echo true || echo false)" "$tether_redirect" \
      "$(settings get global private_dns_mode 2>/dev/null)" \
      "$CONFIG" \
      "$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null)" \
      "$(servers_get)" \
      "$([ -f "$RESOLVERS_CACHE" ] && echo true || echo false)" \
      "$([ -f "$MANUAL_STOP" ] && echo true || echo false)"
    ;;
  set)
    # Значение обязано быть передано, но пустым быть может: для run_gid пустота
    # и есть "по умолчанию". Проверять -n "$3" здесь нельзя, иначе сбросить ключ
    # штатными средствами невозможно.
    [ -n "$2" ] && [ "$#" -ge 3 ] || { echo "использование: dnscrypt-ctl set <ключ> <значение>"; exit 1; }
    case "$2" in
      run_gid)
        # default и none - псевдонимы пустоты: в шелле пустой аргумент легко
        # теряется между слоями кавычек.
        case "$3" in default|none) set -- "$1" "$2" "" ;; esac
        valid_value "$2" "$3" || exit 1
        ;;
      autostart|redirect_ipv4|redirect_ipv6|tether_redirect|disable_private_dns|restart_delay_max)
        [ -n "$3" ] || { echo "пустое значение допустимо только для run_gid"; exit 1; }
        valid_value "$2" "$3" || exit 1
        ;;
      mirror_config)
        echo "mirror_config удалён в 2.3: модуль больше ничего не держит"
        echo "на внутренней памяти. Настройки живут только в $SETTINGS"
        exit 1
        ;;
      *) echo "неизвестный ключ: $2"; exit 1 ;;
    esac
    touch "$SETTINGS"
    if grep -qE "^[[:space:]]*$2[[:space:]]*=" "$SETTINGS"; then
      sed -i "s|^[[:space:]]*$2[[:space:]]*=.*|$2=$3|" "$SETTINGS"
    else
      echo "$2=$3" >>"$SETTINGS"
    fi
    echo "$2=$3 (применится после dnscrypt-ctl restart)"
    ;;
  reset)
    # Шаблон остаётся в модуле после установки: customize.sh чистит
    # только binary и tools.
    TEMPLATE="$MODDIR/config/module.conf"
    [ -f "$TEMPLATE" ] || { echo "нет шаблона $TEMPLATE"; exit 1; }
    if [ -f "$SETTINGS" ]; then
      backup="$SETTINGS-$(date +%Y%m%d%H%M%S).bak"
      cp -f "$SETTINGS" "$backup" 2>/dev/null && echo "прежние настройки: $backup"
    fi
    cp -f "$TEMPLATE" "$SETTINGS" || exit 1
    chmod 0600 "$SETTINGS" 2>/dev/null
    echo "настройки сброшены (применится после dnscrypt-ctl restart)"
    ;;
  start)
    if supervisor_running; then
      echo "уже запущено"
    else
      rm -f "$MANUAL_STOP"
      start_supervisor; echo "запущено"
    fi
    ;;
  stop)    stop_all; nf_stop; restore_private_dns; touch "$MANUAL_STOP"; echo "остановлено, правила сняты" ;;
  restart) rm -f "$MANUAL_STOP"; stop_all; sleep 1; start_supervisor; echo "перезапущено" ;;
  rules)
    nf_init_cmd
    $IPT -t nat -L $NAT_CHAIN -n --line-numbers 2>/dev/null || echo "цепочки нет"
    $IPT6 -t nat -L $NAT_CHAIN -n --line-numbers 2>/dev/null
    ;;
  log)      tail -n "${2:-50}" "$LOGFILE" 2>/dev/null || { echo "журнала нет"; exit 1; } ;;
  proxylog) tail -n "${2:-50}" "$DATADIR/dnscrypt-proxy.log" 2>/dev/null \
              || tail -n "${2:-50}" "$DATADIR/stdout.log" 2>/dev/null \
              || { echo "журнала нет"; exit 1; } ;;
  test)
    port=$(listen_port)
    if command -v nslookup >/dev/null 2>&1; then
      nslookup example.com 127.0.0.1 -port="$port" 2>&1 | tail -n 6
    elif port_busy "$port"; then
      echo "прокси слушает порт $port"
    else
      echo "на порту $port никто не слушает"
    fi
    # Главное - доходят ли системные запросы до прокси. Резолвим уникальное
    # имя через системный резолвер (ping) и смотрим, выросли ли счётчики DNAT.
    nf_init_cmd
    before=$(dnat_packets)
    ping -c 1 -W 1 "dnscrypt-test-$$-$(date +%s).example.com" >/dev/null 2>&1
    after=$(dnat_packets)
    if [ "$after" -gt "$before" ]; then
      echo "системный DNS идёт через прокси (пакетов через перехват: $((after - before)))"
    else
      echo "системный DNS НЕ дошёл до перехвата: запросы идут мимо прокси"
      echo "IPv6 DNS: $(nf_ipv6_state); подробности: dnscrypt-ctl conflicts"
      exit 1
    fi
    ;;
  export|import)
    echo "удалено в 2.3: модуль не использует внутреннюю память."
    echo "Конфиг: $CONFIG - правьте через приложение или root-редактором."
    exit 1
    ;;
  servers)
    case "$2" in
      list)
        servers_list || { echo "кэш резолверов ещё не скачан: $RESOLVERS_CACHE"; exit 1; }
        ;;
      raw)
        # Весь public-resolvers.md: имя, описание и sdns-стампы. Разбирать
        # стампы удобнее на стороне приложения, здесь только отдаём файл.
        cat "$RESOLVERS_CACHE" 2>/dev/null || { echo "кэш резолверов ещё не скачан"; exit 1; }
        ;;
      relays)
        cat "$RELAYS_CACHE" 2>/dev/null || { echo "кэш релеев ещё не скачан"; exit 1; }
        ;;
      info)
        if [ -f "$RESOLVERS_CACHE" ]; then
          echo "файл: $RESOLVERS_CACHE"
          echo "обновлён: $(date -r "$RESOLVERS_CACHE" '+%Y-%m-%d %H:%M' 2>/dev/null)"
          echo "серверов: $(grep -c '^## ' "$RESOLVERS_CACHE")"
        else
          echo "кэш резолверов ещё не скачан"
          exit 1
        fi
        echo "выбрано: $(servers_get)"
        ;;
      get) servers_get ;;
      set)
        [ -n "$3" ] || { echo "использование: dnscrypt-ctl servers set имя1,имя2"; exit 1; }
        servers_set "$3" || { echo "не удалось записать server_names"; exit 1; }
        echo "server_names = $(servers_get) (применится после restart)"
        ;;
      add)
        [ -n "$3" ] || { echo "использование: dnscrypt-ctl servers add имя"; exit 1; }
        cur=$(servers_get)
        [ "$cur" = auto ] && cur=""
        case ",$cur," in
          *",$3,"*) echo "$3 уже в списке"; exit 0 ;;
        esac
        servers_set "${cur:+$cur,}$3" || { echo "не удалось добавить $3"; exit 1; }
        echo "server_names = $(servers_get) (применится после restart)"
        ;;
      remove|rm)
        [ -n "$3" ] || { echo "использование: dnscrypt-ctl servers remove имя"; exit 1; }
        cur=$(servers_get)
        [ "$cur" = auto ] && { echo "список и так пуст (автоподбор)"; exit 0; }
        new=$(echo "$cur" | tr ',' ' ' | tr -s ' ')
        new=$(for s in $new; do [ "$s" = "$3" ] || printf '%s,' "$s"; done | sed 's/,$//')
        if [ -z "$new" ]; then
          servers_auto || exit 1
          echo "список опустел, включён автоподбор (применится после restart)"
        else
          servers_set "$new" || exit 1
          echo "server_names = $(servers_get) (применится после restart)"
        fi
        ;;
      auto)
        servers_auto || { echo "не удалось изменить конфиг"; exit 1; }
        echo "включён автоподбор серверов по фильтрам require_* (применится после restart)"
        ;;
      active)
        # Строку про выбранный сервер пишет сам прокси при старте.
        line=$(grep -a 'lowest initial latency' "$DATADIR/dnscrypt-proxy.log" 2>/dev/null | tail -n 1)
        if [ -n "$line" ]; then
          echo "$line"
        else
          echo "нет данных, посмотрите dnscrypt-ctl proxylog"
          exit 1
        fi
        ;;
      *)
        echo "dnscrypt-ctl servers list|raw|relays|info|get|set|add|remove|auto|active"
        exit 1
        ;;
    esac
    ;;
  conflicts)
    nf_init_cmd
    echo "--- nat/OUTPUT, порядок сверху вниз ---"
    $IPT -t nat -S OUTPUT 2>/dev/null | grep -v '^-P' | awk '{printf "  %2d  %s\n", NR, $0}'
    echo
    echo "--- цепочки, перехватывающие порт 53 ---"
    for tbl in nat mangle; do
      for ch in $($IPT -t $tbl -S 2>/dev/null | awk '/^-N /{print $2}'); do
        [ "$ch" = "$NAT_CHAIN" ] && continue
        if $IPT -t $tbl -S "$ch" 2>/dev/null | grep -q 'dport 53'; then
          echo "  $tbl/$ch"
        fi
      done
    done
    if $IPT -t nat -S "$NAT_CHAIN" >/dev/null 2>&1; then
      echo "  nat/$NAT_CHAIN (наш)"
    fi
    echo
    echo "--- известные модули ---"
    # Наличие цепочек box ещё не значит перехват DNS: в режиме tproxy его
    # BOX_LOCAL/BOX_EXTERNAL пропускают порт 53 (RETURN). Считаем конфликтом
    # только правила, которые реально заворачивают 53.
    if box_takes_dns; then
      echo "  box_for_magisk: обнаружен, он тоже забирает порт 53."
      echo "    Держать два перехватчика DNS нельзя. Рабочая схема:"
      echo "    dnscrypt-ctl set redirect_ipv4 false; set redirect_ipv6 off"
      echo "    и в конфиге clash/sing-box указать сервером 127.0.0.1:$(listen_port)."
      echo "    Чтобы запросы самого прокси шли мимо box: set run_gid net_admin"
    elif [ -d /data/adb/modules/box_for_root ] || [ -d /data/adb/box ]; then
      echo "  box_for_magisk: установлен, сейчас не перехватывает DNS."
      echo "    Когда он включится, он заберёт порт 53 себе. Его собственный"
      echo "    dnscrypt-proxy по умолчанию тоже слушает 5354 - не включайте оба."
    else
      echo "  box_for_magisk: не обнаружен"
    fi
    port=$(listen_port)
    if port_busy "$port" && ! dnscrypt_pid >/dev/null; then
      echo "  порт $port занят чужим процессом, наш прокси не сможет его открыть"
    fi
    if $IPT -t mangle -S 2>/dev/null | grep -qE 'ZAPRET2_|Z2O_|Z2I_'; then
      echo "  zapret2: обнаружен. Конфликта нет - он работает в mangle по портам"
      echo "    80/443 и не трогает 53. Если DNSCrypt-сервер слушает на 443/udp,"
      echo "    его трафик пойдёт через NFQUEUE, но десинхронизации не подвергнется."
    else
      echo "  zapret2: не обнаружен"
    fi
    if $IPT6 -S OUTPUT 2>/dev/null | grep -q 'dport 53 -j DROP'; then
      echo "  кто-то дропает IPv6-DNS (обычно box при ipv6=false) - наш перехват IPv6 бесполезен"
    fi
    ;;
  *) usage ;;
esac
